# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Jangan commit file .env yang sudah berisi token/password.

# --- Kriteria lowongan ---
# Kata kunci pencarian di JobStreet (dipakai sebagai query pencarian).
KEYWORDS=inventory control,inventory controller,inventory staff,stock controller,PPIC,production planning,production planner,material control,material planner,warehouse,staff gudang,purchasing,procurement,supply chain
# Satu atau banyak lokasi, dipisah koma. Pencarian dijalankan per lokasi.
LOCATIONS=Bandung,Jakarta,Tangerang,Jababeka,Cimahi,Purwakarta,Bogor
# LOCATION hanya dipakai bila LOCATIONS kosong.
LOCATION=Bandung

# Ikut sertakan lowongan yang sepenuhnya remote.
ALLOW_REMOTE=false
# Gaji terendah yang layak dilamar di Glints (gaji kosong tetap dilamar).
GLINTS_MIN_SALARY=4500000
# Perusahaan yang selalu ditolak, dipisah koma (berlaku JobStreet & Glints).
BLOCKED_COMPANIES=royal abadi,ifa
MIN_SALARY=0
MAX_EXPERIENCE_YEARS=5
EXCLUDE_KEYWORDS=principal,director,head,senior,lead
# Perusahaan yang tidak ingin dilamar (mis. mantan perusahaan), dipisah koma.
# Dicocokkan longgar: "royal abadi" menangkap "PT Royal Abadi Sejahtera".
BLACKLIST_COMPANIES=

# Hanya lamar lowongan yang judulnya cocok dengan minat (KEYWORDS).
# false = lamar apa pun yang muncul di hasil pencarian.
REQUIRE_KEYWORD_MATCH=true
# Kata kunci untuk mencocokkan JUDUL lowongan (boleh lebih banyak dari
# KEYWORDS, tidak menambah waktu pencarian). Kosong = ikut KEYWORDS.
# Daftar ini disusun dari pengalaman CV: inventory/stock, gudang/warehouse,
# PPIC/perencanaan produksi, material/pengadaan, supply chain/logistik.
TITLE_KEYWORDS=inventory,stock,stok,persediaan,gudang,warehouse,ppic,production planning,production planner,production control,production admin,admin produksi,staf produksi,staff produksi,perencanaan produksi,demand planning,demand planning,demand planner,capacity planning,material control,material planner,material controller,material handling,material management,bahan baku,pengadaan,purchasing,procurement,pembelian,supply chain,rantai pasok,logistik,logistics,distribusi,distribution,inventory analyst,inventory admin,inventory officer,admin inventory,stock opname,mrp,cycle count,project control

# Tolak lowongan yang lokasinya jelas di luar LOCATION.
# false = tampilkan semua hasil pencarian JobStreet
STRICT_LOCATION=false

# JobStreet & Glints: lamar hanya lowongan yang kartunya menampilkan logo
# perusahaan (gambar kecil di kanan atas kartu). Lowongan tanpa logo dilewati.
# false = semua lowongan boleh dilamar. Periksa dulu deteksinya dengan:
#   python cli.py cek-logo        (JobStreet)
#   python cli.py glints cari     (Glints)
REQUIRE_COMPANY_LOGO=false

# --- Urutan hasil pencarian ---
# ListedDate = dari yang paling baru diposting, KeywordRelevance = relevansi
SORT_MODE=ListedDate
# true  = kumpulkan dulu semua kandidat, lalu lamar mulai dari posting terbaru
#         (lamaran pertama menunggu pencarian selesai).
# false = lamar sambil mencari: halaman 1 semua kata kunci & lokasi dulu
#         (lowongan paling baru), baru turun ke halaman 2 yang lebih lama.
# true + RANK_BY=relevance = bandingkan dulu semua kandidat dari semua lokasi,
# baru lamar yang paling cocok (dipakai untuk batas 50 lamaran/hari).
COLLECT_BEFORE_APPLY=false
PREFER_NEWEST=true
# Urutan pemilihan saat COLLECT_BEFORE_APPLY=true:
#   relevance = kecocokan tertinggi dulu (bawaan)
#   newest    = posting terbaru dulu
RANK_BY=relevance
# 0 = semua umur lowongan. Nilai valid JobStreet: 1, 3, 7, 14, 31
MAX_AGE_DAYS=0

# --- Perilaku sesi ---
# 0 = tanpa batas harian.
MAX_APPLY_PER_DAY=0
DELAY_BETWEEN_APPLY=3
MAX_PAGES=3
HEADLESS_MODE=false

# --- Sesi login ---
# Program TIDAK pernah meminta email/password JobStreet. Login dilakukan
# sendiri di Chrome dan disimpan pada profil di bawah ini.
# Profil Chrome tetap: login sekali, sesi tersimpan untuk sesi berikutnya.
USE_PROFILE=true
# LOGIN_WAIT=false -> jangan menunggu; langsung berhenti bila belum login
LOGIN_WAIT=true
# Lama menunggu login di Chrome (detik); tidak perlu tekan Enter
LOGIN_TIMEOUT=300
# CHROME_PROFILE_DIR=C:\Users\NamaAnda\.dimastes\chrome-profile

# --- Lamaran otomatis ---
# true = bot menekan Lamar/Lanjutkan/Kirim lamaran sendiri (default).
# Pakai `run --manual` bila ingin meninjau sendiri.
AUTO_APPLY=true
# Batas lamaran otomatis per sesi (pengaman tambahan selain MAX_APPLY_PER_DAY)
# 0 = tanpa batas per sesi.
AUTO_APPLY_MAX_PER_SESSION=0
# Detik maksimal mengenali tiap langkah alur lamaran sebelum dilewati
AUTO_APPLY_STEP_TIMEOUT=3
# Detik maksimal di halaman "Review and submit" (menunggu tombol + konfirmasi)
AUTO_APPLY_SUBMIT_TIMEOUT=20
# Simpan HTML/screenshot ke folder debug/ bila alur tidak dikenali
AUTO_APPLY_DEBUG=true

# --- Pertanyaan pilihan dari perusahaan (dropdown) ---
# Jawab otomatis pertanyaan seperti pengalaman kerja, gaji, pendidikan.
# Pertanyaan yang polanya tidak dikenali tidak ditebak: lowongan dilewati.
AUTO_ANSWER_QUESTIONS=true
# Bila ada kuesioner yang tidak bisa dijawab otomatis, bot menunggu sekian
# detik agar Anda mengisinya sendiri di jendela Chrome. Setelah isian lengkap,
# bot melanjutkan dan mengirim lamarannya. 0 = langsung dilewati.
AUTO_ANSWER_WAIT=20
# Gaji yang diharapkan, dalam rupiah (boleh juga "5" atau "5jt"). Kosong =
# pertanyaan gaji tidak dijawab dan lowongan yang memintanya dilewati.
EXPECTED_SALARY=5000000
# Total pengalaman kerja (tahun) untuk pertanyaan "berapa tahun pengalaman".
YEARS_EXPERIENCE=3
# Bidang pengalaman yang Anda miliki. Pertanyaan "berapa tahun pengalaman
# sebagai X" hanya dijawab YEARS_EXPERIENCE bila X ada di daftar ini;
# selebihnya dijawab 0 / "belum ada pengalaman" (tidak mengarang).
EXPERIENCE_ROLES=inventory,stock,stok,persediaan,gudang,warehouse,ppic,production,produksi,material,perencanaan,planner,purchasing,procurement,pembelian,supply chain,logistik,logistics,distribusi,distribution,administrasi,admin,ekspor,impor,import,export,data,furniture,furnitur,manufactur,project control,quality,audit
# Jawab "Ya" untuk pertanyaan ya/tidak seputar kesediaan/pengalaman.
AUTO_ANSWER_YES=true
# Jenjang pendidikan untuk pertanyaan kualifikasi: S1, D3, S2, SMA.
EDUCATION_LEVEL=S1

# --- Isian lamaran otomatis ---
# Teks cover letter/pesan. Kosongkan bila tidak ingin diisi otomatis.
COVER_LETTER=
# Path CV untuk unggah otomatis, mis. C:\Users\ASUS\Documents\cv.pdf
RESUME_PATH=

# --- Notifikasi (opsional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Database (opsional) ---
# DB_PATH=jobstreet_auto.db
